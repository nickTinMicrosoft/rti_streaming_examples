# ============================================================
# RTI Streaming Examples — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it is gitignored.
# ============================================================

# ----- Hospital Simulators -----
EVENTHUB_VITALS_CONN_STR=<your-event-hub-connection-string>
EVENTHUB_VITALS_NAME=hospital-vitals
EVENTHUB_MOVEMENT_CONN_STR=<your-event-hub-connection-string>
EVENTHUB_MOVEMENT_NAME=hospital-movement

# ----- Train Simulators (Event Hub version) -----
EVENTHUB_TRAIN_CONN_STR=<your-event-hub-connection-string>
EVENTHUB_TRAIN_NAME=metrotrain

# ----- Train Simulators (IoT Hub version) -----
IOT_RED_LINE_CONN_STR=<your-iot-hub-device-connection-string>
IOT_BLUE_LINE_CONN_STR=<your-iot-hub-device-connection-string>
IOT_GREEN_LINE_CONN_STR=<your-iot-hub-device-connection-string>

# ----- Flight Tracker -----
EVENTHUB_FLIGHT_CONN_STR=<your-event-hub-connection-string>
EVENTHUB_FLIGHT_NAME=flight-tracker

# ----- Water Quality Monitoring Simulator -----
EVENTHUB_WATER_CONN_STR=<your-event-hub-connection-string>
EVENTHUB_WATER_NAME=water-quality
